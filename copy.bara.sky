# copybara-mirror-release (.gitlab-ci.yml) reuses this file for release branches,
# swapping every quoted main below for the branch name.
core.workflow(
    name = "mirror",
    origin = git.origin(
        url = "${MIRROR_ORIGIN_URL}",
        ref = "main",
    ),
    destination = git.destination(
        url = "https://invalid.example/unused.git",
        fetch = "main",
        push = "main",
    ),
    authoring = authoring.pass_thru("Deckhouse Mirror Bot <mirror@deckhouse.io>"),
    transformations = [
        # Merge request references point to the internal GitLab.
        metadata.scrubber(
            regex = r" \(!\d+\)",
            replacement = "",
        ),
        metadata.scrubber(
            regex = r"\s*See merge request deckhouse/3p/deckhouse/deckhouse-cli!\d+",
            replacement = "",
        ),
    ],
    # Keep in sync with the pathspec in the release:github job (.gitlab-ci.yml).
    origin_files = glob(
        ["**"],
        exclude = [
            "copy.bara.sky",
            ".git/**",
            ".gitlab/**",
            ".gitlab-ci.yml",
            ".github/**",
        ],
    ),
    mode = "ITERATIVE",
)
